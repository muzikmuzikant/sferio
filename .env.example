# PostgreSQL connection string (keep real values out of Git)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Argon2id hash of the private school access code.
# Never put the actual school access code in this file or in Git.
SCHOOL_ACCESS_CODE_HASH=

# Optional: require TLS for PostgreSQL connections
PGSSLMODE=disable

NODE_ENV=development
PORT=8080
